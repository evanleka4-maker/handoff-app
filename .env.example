# Copy to .env for local dev. On Railway, set these as project Variables instead.

PORT=3000
NODE_ENV=production

# Any long random string — used to sign session JWTs.
JWT_SECRET=change-me-to-a-long-random-string

# Where the SQLite file lives. On Railway, point this at a mounted Volume
# (e.g. /data/handoff.db) so it survives redeploys. Locally it defaults to
# ./data/handoff.db if unset.
DB_PATH=./data/handoff.db

# Where generated lease PDFs are written. Should live on the same Volume as
# DB_PATH in production for the same reason.
LEASE_DIR=./data/leases

# Restrict CORS to your deployed frontend origin in production if the
# frontend is ever split into its own domain. Leave unset while the
# frontend is served from this same Express app (the default).
# CORS_ORIGIN=https://your-app.up.railway.app

# How many hours an open ticket can go without a status change before it
# auto-escalates to the property's "Escalation" routing contact.
ESCALATION_HOURS=24
